# --- Base de datos (requerida con datos reales) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/controlmaster?appName=controlmaster
# Opcional: timeout de selección de servidor en ms (default interno)
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# --- Seguridad / producción (obligatorias en NODE_ENV=production) ---
CRON_SECRET=
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENC_KEY=
FILE_ENC_KEY=

# Quién puede entrar a /configuracion (emails separados por coma)
CONFIG_ADMIN_EMAILS=knunez@enlace.org,rjimenez@enlace.org

# --- Correo (opcional en local) ---
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Control Master <alertas@enlacecr.dev>
SMTP_EMAIL=
SMTP_PASSWORD=
EMAIL_FROM=noreply@enlace.org
NEXT_PUBLIC_EMAIL_DEFAULT_RECIPIENTS=ingenieria@enlace.org,rjimenez@enlace.org
NEXT_PUBLIC_EMAIL_SECURITY_RECIPIENT=knunez@enlace.org
NEXT_PUBLIC_EMAIL_FROM_NAME=Control Master
NEXT_PUBLIC_EMAIL_REPLY_TO=soporte@enlace.org

# --- App pública (cliente) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Control Master

# --- WhatsApp (servicio en monorepo-wsp/, opcional en local) ---
WHATSAPP_API_URL=http://localhost:3001
WHATSAPP_API_KEY=change-me-in-production
NEXT_PUBLIC_WHATSAPP_API_URL=http://localhost:3001

# --- Integraciones opcionales ---
# Estado live de YouTube en /api/social/status
YOUTUBE_API_KEY=
# YOUTUBE_MANUAL_LIVE=true
