DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Sesión en ms (opcional; por defecto 7 días: 604800000)
# SESSION_MAX_AGE_MS=604800000

# Opcional: migración calendario ICS (también se aplica automáticamente al primer uso)
# scripts/migrations/001_user_calendar_feed_token.sql
# scripts/migrations/002_report_code.sql
# scripts/migrations/004_operator_duties.sql (diarios; también se aplica al primer uso)
# scripts/migrations/005_operator_duty_multi_assign.sql (misma función en varios operadores)

MONITOR_USER=
MONITOR_PASS=
MONITOR_IFRAME_URL=https://componentes.enlace.org/live/multiview/

# Correo (recomendado: Resend). Reinicia `npm run dev` tras editar .env
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Control Master <alertas@enlacecr.dev>

# Respaldo opcional (Office 365). Si Resend falla y esto está vacío, el envío fallará con mensaje claro.
SMTP_EMAIL=
SMTP_PASSWORD=

CRON_SECRET=
CREDENTIALS_ENC_KEY=
# Optional. Base64 de 32 bytes para cifrar archivos en Neon. Si se omite, se usa CREDENTIALS_ENC_KEY.
FILE_ENC_KEY=
NEXT_PUBLIC_EMAIL_DEFAULT_RECIPIENTS=ingenieria@enlace.org,rjimenez@enlace.org
NEXT_PUBLIC_EMAIL_SECURITY_RECIPIENT=knunez@enlace.org
EMAIL_FROM=noreply@enlace.org
NEXT_PUBLIC_EMAIL_FROM_NAME=Control Master
NEXT_PUBLIC_EMAIL_REPLY_TO=soporte@enlace.org

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Control Master

WHATSAPP_API_URL=http://localhost:3001
WHATSAPP_API_KEY=change-me-in-production
NEXT_PUBLIC_WHATSAPP_API_URL=http://localhost:3001
