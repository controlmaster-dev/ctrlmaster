# Database (Neon PostgreSQL)
# Obtén la URL en: https://console.neon.tech → tu proyecto → Connection string
# En Vercel: nombre = DATABASE_URL, valor = SOLO la URL (sin "DATABASE_URL=" al inicio)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Monitoring Credentials (server-only, never expose with NEXT_PUBLIC_)
MONITOR_USER=
MONITOR_PASS=
MONITOR_IFRAME_URL=https://componentes.enlace.org/live/multiview/

# SMTP Credentials
SMTP_EMAIL=
SMTP_PASSWORD=

# Cron protection (required). Vercel Cron sends "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Encryption key for stored service credentials (32 bytes, base64 encoded).
# Generate with: openssl rand -base64 32
CREDENTIALS_ENC_KEY=

# Email Configuration
NEXT_PUBLIC_EMAIL_DEFAULT_RECIPIENTS=ingenieria@enlace.org,rjimenez@enlace.org
NEXT_PUBLIC_EMAIL_SECURITY_RECIPIENT=knunez@enlace.org
EMAIL_FROM=noreply@enlace.org
NEXT_PUBLIC_EMAIL_FROM_NAME=Control Master
NEXT_PUBLIC_EMAIL_REPLY_TO=soporte@enlace.org

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Control Master

# WhatsApp API (CtrlMaster WhatsApp API)
WHATSAPP_API_URL=http://localhost:3001
WHATSAPP_API_KEY=change-me-in-production
# Public URL for client-side health checks
NEXT_PUBLIC_WHATSAPP_API_URL=http://localhost:3001
