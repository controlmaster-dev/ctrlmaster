{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": true,
    "tsBuildInfoFile": ".cache/typecheck-app.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "monorepo-wsp",
    "tests",
    "scripts",
    "electron",
    "dist",
    "dist-desktop",
    ".next"
  ]
}
